<UserControl x:Class="CNCController.TopMenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="50" d:DesignWidth="800">
    <Grid Background="#2E2E2E">
        <Menu Background="#2E2E2E" Foreground="White" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <!-- Project Menu -->
            <MenuItem Header="Project">
                <MenuItem Header="New Project" Foreground="Black" />
                <MenuItem Header="Open Project" Foreground="Black" />
                <MenuItem Header="Save Project" Foreground="Black" />
                <MenuItem Header="Close Project" Foreground="Black" />
            </MenuItem>

            <!-- Edit Menu -->
            <MenuItem Header="Edit">
                <MenuItem Header="Undo" Foreground="Black" />
                <MenuItem Header="Redo"  Foreground="Black"/>
                <MenuItem Header="Cut" Foreground="Black" />
                <MenuItem Header="Copy" Foreground="Black"/>
                <MenuItem Header="Paste" Foreground="Black"/>
            </MenuItem>

            <!-- Machine Menu -->
            <MenuItem Header="Machine">
                <MenuItem Header="Connect" Foreground="Black" />
                <MenuItem Header="Disconnect" Foreground="Black" />
                <MenuItem Header="Settings" Foreground="Black"  />
                <MenuItem Header="Run Setup Wizard" Command="{Binding RunSetupWizardCommand}" Foreground="Black" />
            </MenuItem>

            <!-- Toolbox Menu -->
            <MenuItem Header="Toolbox">
                <MenuItem Header="Tool Library" Foreground="Black" />
                <MenuItem Header="Add Tool" Foreground="Black" />
                <MenuItem Header="Manage Tools" Foreground="Black" />
            </MenuItem>

            <!-- Help Menu -->
            <MenuItem Header="Help">
                <MenuItem Header="User Manual" Foreground="Black" />
                <MenuItem Header="About" Foreground="Black" />
            </MenuItem>
        </Menu>
        
        <!-- Buttons Section -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,0" HorizontalAlignment="Right">
            <!-- Carve Button -->
            <Button x:Name="CarveButton" Content="Carve" Width="80" Height="30" Background="#007ACC" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Click="CarveButton_Click" />
            
            <!-- Jog Button -->
            <Button x:Name="JogButton" Content="Jog" Width="80" Height="30" Background="#444" Foreground="White" FontWeight="Bold" Command="{Binding ShowJoggingControlCommand}" />
        </StackPanel>
    </Grid>
</UserControl>